rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    match /transactions/{txId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

    match /categories/{catId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || resource.data.userId == 'system');
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.userId;
    }

    // Invoices: creator can manage; anyone with the link (invoiceId) can read
    // and update status (recipient actions). The invoiceId acts as a shared secret.
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorId;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.creatorId;
    }

    // Credit card bills: only the owner can read and write.
    match /creditCardBills/{billId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
    }

  }
}
